# ==============================================================================
# Django Core Settings
# ==============================================================================
# Generate a secret key or leave default for local development
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-in-production-min-50-chars
DJANGO_DEBUG=True
# Comma-separated allowed hosts (10.0.2.2 is required for Android emulators)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*

# ==============================================================================
# Database Configuration
# ==============================================================================
# Leave DATABASE_URL commented out to default to local SQLite (db.sqlite3).
# Uncomment if connecting to a PostgreSQL server:
# DATABASE_URL=postgresql://ewallet_user:ewallet_secure_password@localhost:5432/ewallet_db

# ==============================================================================
# Redis & Celery (Synchronous / Eager by default for dev)
# ==============================================================================
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==============================================================================
# JWT Authentication
# ==============================================================================
JWT_SECRET_KEY=jwt-secret-key-change-me-for-production
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ==============================================================================
# Security & CORS Settings (Allows Flutter Web and Mobile Emulators)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

